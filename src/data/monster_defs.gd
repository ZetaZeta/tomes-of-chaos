class_name MonsterDefs
extends RefCounted
## Creatures. Used for pre-placed dungeon monsters AND as summons.
##
##   id, name, arch (placeholder sprite template), colour, hp, move, dmg, tier(1-5), abilities, opts
## opts:
##   dt       damage type of the melee attack (default phys)
##   rg       [range, dmg, type, status?, turns?]  ranged attack
##   on_hit   [status, turns]  melee hits also inflict this
##   minion   monster id spawned by "summoner"
##   summon   true = not generated in dungeons (only appears via spells)
##
## Abilities: fly swim undead construct fiend stationary sleeper guard boss
##   regen explode split teleport twice thorns reach heavy stealth summoner
##   aura_fire aura_cold  imm:<dtype> res:<dtype> vul:<dtype>  immst:<status>
## Tiers roughly set HP: T1 1-2, T2 2-3, T3 3-5, T4 4-7, T5 6-10.

static func m(id: String, nm: String, arch: String, col: String, hp: int, mv: int, dmg: int,
		tier: int, ab: Array = [], opts: Dictionary = {}) -> void:
	var d := {"id": id, "nm": nm, "arch": arch, "col": Color(col), "hp": hp, "mv": mv, "dmg": dmg,
		"tier": tier, "ab": ab, "dt": "phys"}
	for k in opts:
		d[k] = opts[k]
	if ab.has("stationary"):
		d["mv"] = 0           # rooted to the spot: show it as such
	DB.monsters[id] = d

