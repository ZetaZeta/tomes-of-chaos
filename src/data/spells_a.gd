	L.append(SB.cone("gust_of_wind", "Gust of Wind", "storm", 1, 4, [Fx.push(2)], "Sweeps small things away."))
	L.append(SB.burst("whirlwind", "Whirlwind", "storm", 3, 5, 1, [Fx.push(2, "", true)], "Hurls creatures outward."))
	L.append(SB.sp("call_lightning", "Call Lightning", "storm", 3, "tile", 7, "single", 0, [Fx.dmg(3, "elec")], "Lightning from a clear sky."))
	L.append(SB.burst("storm_cloud_spell", "Raincloud", "storm", 3, 6, 1, [Fx.obj("storm_cloud")], "A storm cloud crackles overhead."))
	L.append(SB.buff("static_shield", "Static Shield", "storm", 2, [Fx.st("thorns", 6), Fx.st("warded", 6)], "Crackling charge repels attackers."))
	L.append(SB.burst("ball_lightning", "Ball Lightning", "storm", 4, 6, 1, [Fx.dmg(2, "elec")], "A sphere of lightning."))
	L.append(SB.sp("thunderstorm", "Thunderstorm", "storm", 5, "self", 8, "los", 8, [Fx.dmg(3, "elec", "foe"), Fx.st("stunned", 1, 1, "foe")], "Lightning strikes every enemy you see.", {"selective": true}))
	L.append(SB.ray("sonic_boom", "Sonic Lance", "storm", 3, 5, [Fx.dmg(1, "sonic"), Fx.push(1)], "A wall of sound."))
