	L.append(SB.aura("frost_nova", "Frost Nova", "cryomancy", 3, 2, [Fx.dmg(1, "cold"), Fx.st("slowed", 2)], "Winter bursts outward."))
	L.append(SB.bolt("flash_freeze", "Flash Freeze", "cryomancy", 3, 5, [Fx.st("frozen", 2)], "Encase a foe in ice for two turns."))
