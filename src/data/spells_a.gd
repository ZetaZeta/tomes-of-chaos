	L.append(SB.burst("sleet_storm", "Sleet Storm", "cryomancy", 3, 6, 2, [Fx.obj("grease"), Fx.st("slowed", 3), Fx.trip(0.4)], "Freezing rain and slick ice."))
	L.append(SB.buff("frost_armor", "Frost Armour", "cryomancy", 2, [Fx.st("stoneskin", 4), Fx.st("thorns", 8)], "A coat of rime that bites those who strike you."))
	L.append(SB.sp("absolute_zero", "Absolute Zero", "cryomancy", 5, "self", 8, "los", 8, [Fx.dmg(3, "cold", "foe"), Fx.st("frozen", 1, 1, "foe")], "The temperature drops to nothing.", {"selective": true}))
	L.append(SB.bolt("deathfrost", "Deathfrost", "cryomancy", 5, 6, [Fx.kill("", 4, 2, "", "cold")], "Heart freezes solid."))
	L.append(SB.cone("chill_wind", "Chill Wind", "cryomancy", 2, 3, [Fx.push(2), Fx.st("slowed", 2)], "An icy gale."))
