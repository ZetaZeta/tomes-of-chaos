	L.append(SB.burst("smoke_screen", "Smoke Screen", "pyromancy", 2, 6, 2, [Fx.obj("fog"), Fx.st("blind", 1, 1, "foe")], "Thick, choking smoke blocks sight and blinds foes for a moment."))
