	L.append(SB.bolt("static_discharge", "Static Discharge", "storm", 2, 5, [Fx.dmg(1, "elec"), Fx.st("marked", 3)], "Shocked and exposed."))
	L.append(SB.ray("lightning_lance", "Lightning Lance", "storm", 4, 8, [Fx.dmg(4, "elec")], "A devastating bolt."))
	L.append(SB.burst("cyclone", "Cyclone", "storm", 4, 5, 2, [Fx.push(3, "", true), Fx.st("confused", 2)], "A raging vortex."))
	L.append(SB.burst("thunderous_blast", "Shatter Sound", "storm", 2, 5, 1, [Fx.shatter(), Fx.dmg(1, "sonic")], "Sound shakes things apart."))
	L.append(SB.buff("wind_wall_self", "Storm Shroud", "storm", 3, [Fx.st("warded", 8), Fx.st("levitating", 4)], "Wind lifts and wraps you."))
